[flake8]
# Ruff is the linter of record for this repository; see [tool.ruff.lint] in
# pyproject.toml. flake8 runs one job and one job only: the continuation-line indent
# checks in the E12/E13 range, which ruff implements no rule for. Nothing outside that
# range belongs in this file, because nothing outside it is ever selected.
#
# `select` is set here rather than only on the command line so that a bare `flake8` by
# hand reports exactly what the gate reports.
select = E12, E13

# The house style is column-aligned assignments, imports and trailing comments, which
# produces continuation lines that these particular checks would flag. The ones left
# enforced are E123, E125 and E133.
ignore = E121, E122, E124, E126, E127, E128, E129, E131
